<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.librarymanagementsystem.controller.AddMemberController"
            prefWidth="900" prefHeight="650">

    <top>
        <HBox style="-fx-background-color: #1e3c72; -fx-padding: 15;" spacing="15" alignment="CENTER_LEFT">
            <Button text="⬅ Back" styleClass="btn-secondary" onAction="#goBack"/>
            <Label text="Register New Member" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <GridPane hgap="20" vgap="15" style="-fx-padding: 40;" alignment="CENTER">
            <Label text="Member ID:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="memberIdField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

            <Label text="Full Name:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Email:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="emailField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Phone Number:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="phoneField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Address:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextArea fx:id="addressField" prefHeight="80" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <HBox spacing="15" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-padding: 15 0 0 0;">
                <Button text="Register Member" styleClass="btn-primary" onAction="#handleRegister" prefWidth="180"/>
                <Button text="Clear" styleClass="btn-secondary" onAction="#handleClear" prefWidth="150"/>
            </HBox>
        </GridPane>
    </center>
</BorderPane>