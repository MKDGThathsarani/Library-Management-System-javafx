<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.librarymanagementsystem.controller.IssueBookController"
            prefWidth="900" prefHeight="650">

    <top>
        <HBox style="-fx-background-color: #1e3c72; -fx-padding: 15;" spacing="15" alignment="CENTER_LEFT">
            <Button text="⬅ Back" styleClass="btn-secondary" onAction="#goBack"/>
            <Label text="Issue Book" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <GridPane hgap="20" vgap="15" style="-fx-padding: 40;" alignment="CENTER">
            <Label text="Select Member:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="memberCombo" promptText="Choose member" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

            <Label text="Select Book:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="bookCombo" promptText="Choose book" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="300"/>

            <Label text="Issue Date:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <DatePicker fx:id="issueDatePicker" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="300"/>

            <Label text="Due Date:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <DatePicker fx:id="dueDatePicker" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300"/>

            <HBox spacing="15" GridPane.rowIndex="4" GridPane.columnIndex="1" style="-fx-padding: 15 0 0 0;">
                <Button text="Issue Book" styleClass="btn-primary" onAction="#handleIssue" prefWidth="150"/>
                <Button text="Clear" styleClass="btn-secondary" onAction="#handleClear" prefWidth="150"/>
            </HBox>
        </GridPane>
    </center>
</BorderPane>