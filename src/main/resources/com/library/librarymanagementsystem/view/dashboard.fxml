<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.librarymanagementsystem.controller.DashboardController"
            prefWidth="1100" prefHeight="700">

    <!-- Sidebar -->
    <left>
        <VBox styleClass="sidebar" spacing="10">
            <Label text="📚 Library MS" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 0 0 20 0;"/>
            <Button text="🏠  Dashboard" styleClass="sidebar-button" onAction="#goDashboard"/>
            <Button text="➕  Add Book" styleClass="sidebar-button" onAction="#goAddBook"/>
            <Button text="👥  Add Member" styleClass="sidebar-button" onAction="#goAddMember"/>
            <Button text="📋  View Members" styleClass="sidebar-button" onAction="#goViewMembers"/>
            <Button text="📤  Issue Book" styleClass="sidebar-button" onAction="#goIssueBook"/>
            <Button text="📥  Return Book" styleClass="sidebar-button" onAction="#goReturnBook"/>
            <Button text="🕓  History" styleClass="sidebar-button" onAction="#goHistory"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="🚪  Logout" styleClass="sidebar-button" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="25" style="-fx-padding: 40;">
            <Label text="Dashboard Overview" styleClass="page-title"/>

            <HBox spacing="20">
                <VBox styleClass="stat-card" alignment="CENTER">
                    <Label text="120" styleClass="stat-number"/>
                    <Label text="Total Books" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card" alignment="CENTER">
                    <Label text="45" styleClass="stat-number"/>
                    <Label text="Total Members" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card" alignment="CENTER">
                    <Label text="18" styleClass="stat-number"/>
                    <Label text="Borrowed" styleClass="stat-label"/>
                </VBox>
                <VBox styleClass="stat-card" alignment="CENTER">
                    <Label text="5" styleClass="stat-number" style="-fx-text-fill: #e74c3c;"/>
                    <Label text="Overdue" styleClass="stat-label"/>
                </VBox>
            </HBox>

            <Label text="Welcome to the Library Management System." style="-fx-font-size: 14px; -fx-text-fill: #555;"/>
        </VBox>
    </center>
</BorderPane>