<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.library.librarymanagementsystem.controller.LoginController"
           styleClass="login-container"
           prefWidth="900" prefHeight="600">

    <VBox styleClass="login-card" alignment="CENTER" spacing="15" maxWidth="400" maxHeight="450">
        <Label text="📚 Library Login" styleClass="login-title"/>
        <Label text="Enter your credentials to continue" style="-fx-text-fill: #666;"/>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Username" styleClass="form-label"/>
            <TextField fx:id="usernameField" promptText="Enter username" prefWidth="300"/>
        </VBox>

        <VBox spacing="5" alignment="CENTER_LEFT">
            <Label text="Password" styleClass="form-label"/>
            <PasswordField fx:id="passwordField" promptText="Enter password" prefWidth="300"/>
        </VBox>

        <Label fx:id="errorLabel" text="" style="-fx-text-fill: red;"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Login" styleClass="btn-primary" onAction="#handleLogin" prefWidth="140"/>
            <Button text="Clear" styleClass="btn-secondary" onAction="#handleClear" prefWidth="140"/>
        </HBox>
    </VBox>
</StackPane>