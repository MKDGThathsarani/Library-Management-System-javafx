<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.librarymanagementsystem.controller.ViewMembersController"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox style="-fx-background-color: #1e3c72; -fx-padding: 15;" spacing="15" alignment="CENTER_LEFT">
            <Button text="⬅ Back" styleClass="btn-secondary" onAction="#goBack"/>
            <Label text="Manage Members" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="🔍 Search member..." prefWidth="250"/>
            <Button text="Search" styleClass="btn-primary" onAction="#handleSearch"/>
        </HBox>
    </top>

    <center>
        <VBox style="-fx-padding: 20;" spacing="15">
            <TableView fx:id="membersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Member ID" prefWidth="120"/>
                    <TableColumn fx:id="colName" text="Full Name" prefWidth="180"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                    <TableColumn fx:id="colPhone" text="Phone" prefWidth="130"/>
                    <TableColumn fx:id="colAddress" text="Address" prefWidth="200"/>
                    <TableColumn fx:id="colAction" text="Actions" prefWidth="150"/>
                </columns>
            </TableView>

            <HBox spacing="10">
                <Button text="✏ Edit Selected" styleClass="btn-primary" onAction="#handleEdit"/>
                <Button text="🗑 Delete Selected" styleClass="btn-danger" onAction="#handleDelete"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>