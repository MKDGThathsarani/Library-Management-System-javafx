<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.librarymanagementsystem.controller.HistoryController"
            prefWidth="1100" prefHeight="700">

    <top>
        <HBox style="-fx-background-color: #1e3c72; -fx-padding: 15;" spacing="15" alignment="CENTER_LEFT">
            <Button text="⬅ Back" styleClass="btn-secondary" onAction="#goBack"/>
            <Label text="Borrowing History" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="🔍 Search by member/book..." prefWidth="280"/>
            <Button text="Search" styleClass="btn-primary" onAction="#handleSearch"/>
        </HBox>
    </top>

    <center>
        <VBox style="-fx-padding: 20;" spacing="15">
            <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colMemberId" text="Member ID" prefWidth="110"/>
                    <TableColumn fx:id="colBookTitle" text="Book Title" prefWidth="200"/>
                    <TableColumn fx:id="colIssueDate" text="Issue Date" prefWidth="120"/>
                    <TableColumn fx:id="colDueDate" text="Due Date" prefWidth="120"/>
                    <TableColumn fx:id="colReturnDate" text="Return Date" prefWidth="120"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>