<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.library.librarymanagementsystem.controller.AddBookController"
            prefWidth="900" prefHeight="650">

    <top>
        <HBox style="-fx-background-color: #1e3c72; -fx-padding: 15;" spacing="15" alignment="CENTER_LEFT">
            <Button text="⬅ Back" styleClass="btn-secondary" onAction="#goBack"/>
            <Label text="Add New Book" style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <GridPane hgap="20" vgap="15" style="-fx-padding: 40;" alignment="CENTER">
            <Label text="Book ID / ISBN:" styleClass="form-label" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="bookIdField" promptText="e.g., ISBN-978-3-16" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

            <Label text="Book Title:" styleClass="form-label" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="titleField" promptText="Book title" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Author:" styleClass="form-label" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="authorField" promptText="Author name" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Category:" styleClass="form-label" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <ComboBox fx:id="categoryCombo" promptText="Select category" GridPane.rowIndex="3" GridPane.columnIndex="1" prefWidth="300"/>

            <Label text="Published Year:" styleClass="form-label" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="yearField" promptText="e.g., 2020" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Quantity:" styleClass="form-label" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <TextField fx:id="quantityField" promptText="e.g., 5" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

            <HBox spacing="15" GridPane.rowIndex="6" GridPane.columnIndex="1" style="-fx-padding: 15 0 0 0;">
                <Button text="Add Book" styleClass="btn-primary" onAction="#handleAddBook" prefWidth="150"/>
                <Button text="Clear" styleClass="btn-secondary" onAction="#handleClear" prefWidth="150"/>
            </HBox>
        </GridPane>
    </center>
</BorderPane>